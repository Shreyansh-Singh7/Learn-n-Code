{
    "compilerOptions": {
      "target": "ES2020",
      "module": "ESNext",
      "moduleResolution": "node",
      "esModuleInterop": true,
      "noEmit": true,
      "allowImportingTsExtensions": true,
      "forceConsistentCasingInFileNames": true,
      "strict": true,
      "skipLibCheck": true,
      "resolveJsonModule": true,
      "outDir": "dist",
      "rootDir": "src",
    },
    "include": ["src/server"],
    "exclude": ["node_modules"]
}